@prefix vw: <http://example.org/volkswagen/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
# Vehicle A-box assertions for the Volkswagen ontology.
# Seat model and manufacturer assignments below are illustrative.
# Component assignments and illustrative planned production are grouped with each model.
# Sales profiles and model-fit tags are in VW_Sales_Abox.ttl.

# Powertrain Categories
vw:BatteryElectric a vw:Powertrain ;
    rdfs:label "Battery electric" .

vw:PlugInHybrid a vw:Powertrain ;
    rdfs:label "Plug-in hybrid" .

vw:Petrol a vw:Powertrain ;
    rdfs:label "Petrol" .

vw:Diesel a vw:Powertrain ;
    rdfs:label "Diesel" .

##############################
# A-Box: Volkswagen Group data
##############################

vw:VolkswagenGroup a vw:Company ;
    rdfs:label "Volkswagen Group" ;
    vw:headquarters "Wolfsburg, Germany" ;
    vw:interestsIn
	vw:Normal,
	vw:SportLuxury,
	vw:Trucks .

vw:Normal a vw:BrandGroup ;
    rdfs:label "Normal cars" ;
    vw:hasBrand
	vw:Volkswagen,
	vw:Skoda .

vw:SportLuxury a vw:BrandGroup ;
    rdfs:label "Sport & Luxury cars" ;
    vw:hasBrand 
	vw:Porsche,
	vw:Audi,
	vw:Lamborghini .

vw:Trucks a vw:BrandGroup ;
    rdfs:label "Brand Group Trucks" ;
    vw:hasBrand
	vw:Scania,
	vw:MAN .

# Brand-to-model index; model details are grouped in the model records below.
#Brands
vw:Volkswagen a vw:Brand ;
    rdfs:label "Volkswagen" ;
    vw:hasProductionSite vw:Wolfsburg ;
    vw:hasModel vw:Golf, vw:ID4, vw:Passat .

vw:Skoda a vw:Brand ;
    rdfs:label "Skoda" ;
    vw:hasProductionSite vw:MladaBoleslav ;
    vw:hasModel vw:Octavia, vw:Enyaq .

vw:Porsche a vw:Brand ;
    rdfs:label "Porsche" ;
    vw:hasProductionSite vw:Stuttgart ;
    vw:hasModel vw:911, vw:Taycan, vw:Cayenne .

vw:Audi a vw:Brand ;
    rdfs:label "Audi" ;
    vw:hasProductionSite vw:Ingolstadt ;
    vw:hasModel vw:A4, vw:Q5, vw:e-tron .

vw:Lamborghini a vw:Brand ;
    rdfs:label "Lamborghini" ;
    vw:hasProductionSite vw:SantAgataBolognese ;
    vw:hasModel vw:Urus, vw:Huracan .

vw:Scania a vw:Brand ;
    rdfs:label "Scania" ;
    vw:hasProductionSite vw:Sodertalje ;
    vw:hasModel vw:RSeries .

vw:MAN a vw:Brand ;
    rdfs:label "MAN" ;
    vw:hasProductionSite vw:Munich ;
    vw:hasModel vw:TGX .

# Car models examples

# Vehicle type values
vw:SUV a vw:VehicleType ;
    rdfs:label "SUV" .
vw:Coupe a vw:VehicleType ;
    rdfs:label "Coupe" .
vw:RaceCar a vw:VehicleType ;
    rdfs:label "Race car" .
vw:Sedan a vw:VehicleType ;
    rdfs:label "Sedan" .
vw:Hatchback a vw:VehicleType ;
    rdfs:label "Hatchback" .
vw:Truck a vw:VehicleType ;
    rdfs:label "Truck" .

# Engine model values
vw:EA211_15TSI a vw:EngineModel ;
    rdfs:label "EA211 1.5 TSI" .
vw:ID4ElectricDrive a vw:EngineModel ;
    rdfs:label "ID.4 electric drive" .
vw:OctaviaTSI a vw:EngineModel ;
    rdfs:label "Octavia TSI engine" .
vw:EnyaqElectricDrive a vw:EngineModel ;
    rdfs:label "Enyaq electric drive" .
vw:Porsche911Engine a vw:EngineModel ;
    rdfs:label "911 engine" .
vw:TaycanElectricDrive a vw:EngineModel ;
    rdfs:label "Taycan electric drive" .
vw:CayenneEngine a vw:EngineModel ;
    rdfs:label "Cayenne engine" .
vw:A4TSI a vw:EngineModel ;
    rdfs:label "A4 TSI engine" .
vw:Q5TSI a vw:EngineModel ;
    rdfs:label "Q5 TSI engine" .
vw:ETronElectricDrive a vw:EngineModel ;
    rdfs:label "e-tron electric drive" .
vw:UrusEngine a vw:EngineModel ;
    rdfs:label "Urus engine" .
vw:HuracanEngine a vw:EngineModel ;
    rdfs:label "Huracán engine" .
vw:ScaniaRSeriesEngine a vw:EngineModel ;
    rdfs:label "Scania R-series engine" .
vw:MAN_TGX_Engine a vw:EngineModel ;
    rdfs:label "MAN TGX engine" .

vw:Golf a vw:Model ; 
    rdfs:label "Golf" ;
    vw:modelOf vw:Volkswagen ;
    vw:hasPowertrain vw:Petrol ;
    vw:hasEngineModel vw:EA211_15TSI ;
    vw:seats "5"^^xsd:integer ;
    vw:hasVehicleType vw:Hatchback ;
    vw:hasSeatModel vw:StandardPassengerSeat ;
    vw:hasComponent vw:EA211_15TSI, vw:StandardPassengerSeat, vw:Transmission_Standard, vw:BrakeSystem_Standard, vw:Infotainment_Standard, vw:TyreSet_Standard ;
    vw:customerAppreciationRating "4.3"^^xsd:decimal .

vw:ID4 a vw:Model ; 
    rdfs:label "ID.4" ;
    vw:modelOf vw:Volkswagen ;
    vw:hasPowertrain vw:BatteryElectric ;
    vw:hasEngineModel vw:ID4ElectricDrive ;
    vw:seats "5"^^xsd:integer ;
    vw:hasVehicleType vw:SUV ;
    vw:hasSeatModel vw:StandardPassengerSeat ;
    vw:hasComponent vw:ID4ElectricDrive, vw:StandardPassengerSeat, vw:BatteryPack_MEB, vw:Transmission_Standard, vw:BrakeSystem_Standard, vw:Infotainment_Standard, vw:TyreSet_Standard ;
    vw:customerAppreciationRating "4.1"^^xsd:decimal .

