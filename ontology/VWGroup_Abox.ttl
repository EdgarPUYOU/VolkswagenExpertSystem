# Production sites 
vw:Wolfsburg a vw:ProductionSite ;
    rdfs:label "Volkswagen Wolfsburg Plant" ;
    vw:locatedIn "Wolfsburg, Germany" .

vw:Ingolstadt a vw:ProductionSite ;
    rdfs:label "Audi Ingolstadt Plant" ;
    vw:locatedIn "Ingolstadt, Germany" .

vw:Stuttgart a vw:ProductionSite ;
    rdfs:label "Porsche Stuttgart Plant" ;
    vw:locatedIn "Stuttgart, Germany" .

vw:MladaBoleslav a vw:ProductionSite ;
    rdfs:label "Škoda Mladá Boleslav Plant" ;
    vw:locatedIn "Mladá Boleslav, Czech Republic" .

vw:SantAgataBolognese a vw:ProductionSite ;
    rdfs:label "Lamborghini Sant’Agata Bolognese Plant" ;
    vw:locatedIn "Sant’Agata Bolognese, Italy" .

vw:Sodertalje a vw:ProductionSite ;
    rdfs:label "Scania Södertälje Plant" ;
    vw:locatedIn "Södertälje, Sweden" .

vw:Munich a vw:ProductionSite ;
    rdfs:label "MAN Munich Plant" ;
    vw:locatedIn "Munich, Germany" .

# Illustrative seat production sites
vw:PassengerSeatPlant a vw:ProductionSite ;
    rdfs:label "Passenger seat production site (illustrative)" ;
    vw:locatedIn "Illustrative location" .

vw:PerformanceSeatPlant a vw:ProductionSite ;
    rdfs:label "Performance seat production site (illustrative)" ;
    vw:locatedIn "Illustrative location" .

vw:CommercialSeatPlant a vw:ProductionSite ;
    rdfs:label "Commercial seat production site (illustrative)" ;
    vw:locatedIn "Illustrative location" .

# Illustrative seat models and manufacturers
vw:PassengerSeatManufacturer a vw:SeatManufacturer ;
    rdfs:label "Northstar Seating" .

vw:PerformanceSeatManufacturer a vw:SeatManufacturer ;
    rdfs:label "Apex Performance Seating" .

vw:CommercialSeatManufacturer a vw:SeatManufacturer ;
    rdfs:label "Roadstead Commercial Seating" .

vw:StandardPassengerSeat a vw:SeatModel ;
    rdfs:label "Standard passenger seat model (illustrative)" ;
    vw:hasSeatManufacturer vw:PassengerSeatManufacturer ;
    vw:seatPrice "450.00"^^xsd:decimal ;
    vw:seatProducedAt vw:PassengerSeatPlant .

vw:PerformanceSeat a vw:SeatModel ;
    rdfs:label "Performance seat model (illustrative)" ;
    vw:hasSeatManufacturer vw:PerformanceSeatManufacturer ;
    vw:seatPrice "1250.00"^^xsd:decimal ;
    vw:seatProducedAt vw:PerformanceSeatPlant .

vw:CommercialSeat a vw:SeatModel ;
    rdfs:label "Commercial vehicle seat model (illustrative)" ;
    vw:hasSeatManufacturer vw:CommercialSeatManufacturer ;
    vw:seatPrice "700.00"^^xsd:decimal ;
    vw:seatProducedAt vw:CommercialSeatPlant .

