    vw:supplierLeadTimeDays 50 .

vw:PerformanceSeatManufacturer a vw:SeatManufacturer, vw:Supplier ;
    vw:supplierCountry "Germany" ;
    vw:supplierLeadTimeDays 60 .

vw:CommercialSeatManufacturer a vw:SeatManufacturer, vw:Supplier ;
    vw:supplierCountry "Sweden" ;
    vw:supplierLeadTimeDays 55 .

# Fictional supplier production sites

