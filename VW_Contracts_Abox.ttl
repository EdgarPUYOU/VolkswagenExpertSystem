@prefix vw:   <http://example.org/volkswagen/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

vw:VolumeExceedsCommitment a vw:RenegotiationReason ;
    rdfs:label "Projected volume exceeds contracted commitment" .

vw:VolumeDiscountAvailable a vw:RenegotiationReason ;
    rdfs:label "Lower-price volume discount tier is available" .

# All suppliers, component costs, contract terms, and production targets below are illustrative.
# Projected annual component volumes are pooled sums over covered models; recalculate if targets or mappings change.

# Component categories
vw:EngineAssembly a vw:ComponentCategory ;
    rdfs:label "Engine assembly" .

vw:ElectricDriveUnit a vw:ComponentCategory ;
    rdfs:label "Electric drive unit" .

vw:BatteryPackCategory a vw:ComponentCategory ;
    rdfs:label "Battery pack" .

vw:SeatAssembly a vw:ComponentCategory ;
    rdfs:label "Seat set" .

vw:TransmissionCategory a vw:ComponentCategory ;
    rdfs:label "Transmission" .

vw:BrakingSystemCategory a vw:ComponentCategory ;
    rdfs:label "Braking system" .

vw:InfotainmentCategory a vw:ComponentCategory ;
    rdfs:label "Infotainment" .

vw:TyreSetCategory a vw:ComponentCategory ;
    rdfs:label "Tyre set" .

# Fictional suppliers and illustrative lead times

vw:Supplier_PowertrainWorks a vw:Supplier ;
