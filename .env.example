# Copy to .env (never commit .env).
SITE_ADDRESS=erp.example.com
BASIC_AUTH_USER=admin
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Escape every $ in the hash as $$ when it is stored in .env for docker compose.
BASIC_AUTH_HASH=
# Match the owner of ./data on the host (id -u / id -g).
APP_UID=1000
APP_GID=1000

# Language model behind the chat bubble (optional). Without a key the rule-based planner is used.
# The key stays on the server and is never sent to the browser. Never commit .env.
ANTHROPIC_API_KEY=
# Change this to point at a proxy or gateway instead of the Anthropic API.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5
