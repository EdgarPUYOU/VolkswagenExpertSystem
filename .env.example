# Copy to .env (never commit .env).
SITE_ADDRESS=erp.example.com
# Login for the web UI (the app checks it, no proxy auth needed). Leave APP_PASSWORD empty to switch login off,
# for local development only. Production refuses to start without it. Use a long random password.
APP_USER=admin
APP_PASSWORD=
# Match the owner of ./data on the host (id -u / id -g).
APP_UID=1000
APP_GID=1000

# Language model behind the chat bubble (optional). Any OpenAI-compatible API works.
# Without a key the rule-based planner is used. The key stays on the server and is never sent to the browser.
# A host-only AI_BASE_URL gets /v1 appended. The model must support tool calling.
# Never commit .env.
AI_API_KEY=
AI_BASE_URL=https://ai.sumopod.com/v1
AI_MODEL=gpt-4o-mini
# Reasoning models (for example gpt-6-luna) refuse tools unless this is none. Leave empty for other models.
AI_REASONING_EFFORT=

# Deploy target for `make deploy` (key-based ssh, see docs/deploy.md). Path is relative to the ssh home.
DEPLOY_HOST=
DEPLOY_PATH=vw
