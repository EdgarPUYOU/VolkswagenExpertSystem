# Copy to .env (never commit .env).
SITE_ADDRESS=erp.example.com
BASIC_AUTH_USER=admin
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Escape every $ in the hash as $$ when it is stored in .env for docker compose.
BASIC_AUTH_HASH=
# Match the owner of ./data on the host (id -u / id -g).
APP_UID=1000
APP_GID=1000
